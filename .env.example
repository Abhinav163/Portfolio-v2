# Copy this file to .env.local and fill in the values.
# Without SMTP_USER / SMTP_PASS the contact form still works in `npm run dev`:
# messages are printed to the terminal instead of being emailed.

# --- Email delivery (Gmail shown; any SMTP provider works) -------------------
# Gmail needs an App Password, not your normal password:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abhinavsharmaworkspace1@gmail.com
SMTP_PASS=

# Where contact-form messages are delivered (defaults to SMTP_USER).
CONTACT_TO_EMAIL=abhinavsharmaworkspace1@gmail.com

# Optional: sender address (defaults to SMTP_USER; Gmail requires your own address or a verified alias).
# CONTACT_FROM_EMAIL=
# Optional: force TLS on/off (defaults to true for port 465).
# SMTP_SECURE=true

# --- Site URL used for canonical links, sitemap and social previews ----------
# Vercel fills this in automatically from the production domain; set it for other hosts.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
